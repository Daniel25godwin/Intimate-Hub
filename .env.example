# Public Firebase web config (safe client-side, prefix required by Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only — set these in Vercel project settings, NOT with a VITE_ prefix.
# FIREBASE_SERVICE_ACCOUNT is the full service-account JSON, minified to one line.
FIREBASE_SERVICE_ACCOUNT=
# Phase 2:
# PAYSTACK_SECRET_KEY=
# VITE_PAYSTACK_PUBLIC_KEY=

# Cloudinary (image hosting, free tier) — secret is server-only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
